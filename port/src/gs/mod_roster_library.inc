static const char* rb_milk_comment(int cid,const char*name,bool es){
 // New comments, not substituted biographies or claimed original voiced lines.
 if(cid==0||cid==1||cid==2||cid==3||cid==4)return es?"¡Goku! Puedes entrenar después de ayudar en casa. ¡Y nada de saltarte la comida!":"Goku! Training can wait until you help at home. And do not skip dinner!";
 if(cid>=5&&cid<=10)return es?"¡Otra vez con ese pelo! Al menos dime que esta vez volverás a tiempo para cenar.":"That hair again! At least tell me you will make it home in time for dinner.";
 if(strstr(name,"Gohan"))return es?"¡Ese es mi Gohan! Puede salvar el mundo, pero los estudios siguen siendo importantes.":"That is my Gohan! Saving the world is wonderful, but his studies still matter.";
 if(strstr(name,"Goten"))return es?"¡Goten! Nada de practicar esas técnicas dentro de casa. Ya tuve suficiente con una pared rota.":"Goten! No practicing those techniques indoors. One broken wall was quite enough.";
 if(strstr(name,"Vegeta"))return es?"Otro saiyajin que solo piensa en entrenar... ¡Pobre Bulma!":"Another Saiyan who thinks of nothing but training... Poor Bulma!";
 if(strstr(name,"SSJ")||strstr(name,"Saiyajin")||strstr(name,"Saiyan"))return es?"¡Más pelo rubio y más músculos! ¿Y quién va a recoger todo cuando terminen de pelear?":"More golden hair and more muscles! And who is cleaning up after all that fighting?";
 if(strstr(name,"Picc")||strstr(name,"Piccolo"))return es?"¡No creas que he olvidado lo duro que entrenaste a Gohan! Aunque... sé cuánto te importa.":"I have not forgotten how hard you trained Gohan! Though... I know how much you care about him.";
 if(strstr(name,"Free")||strstr(name,"Cell")||strstr(name,"Buu"))return es?"¡Ni se te ocurra acercarte a mi familia! Y cuidado con los muebles.":"Do not even think about going near my family! And mind the furniture.";
 if(strstr(name,"Krill")||strstr(name,"Kril"))return es?"Por lo menos tú sabes que una familia también necesita tiempo. ¡A ver si Goku aprende!":"At least you know a family needs your time too. Perhaps Goku could learn something!";
 if(strstr(name,"Shenron"))return es?"¿Otro dragón? Espero que este no cobre la visita con mi vajilla.":"Another dragon? I hope this one does not charge for the visit by smashing my dishes.";
 return es?"Con tanta gente fuerte aquí, nadie tiene excusa para dejarme todas las tareas. ¡Una cosa no quita la otra!":"With so many strong people here, nobody has an excuse to leave all the chores to me!";
}
