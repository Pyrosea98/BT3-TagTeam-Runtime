*.ipch

# Now we can place the dump code here and test while expand the Runtime
ps2xRuntime/include/ps2_recompiled_functions.h
ps2xRuntime/include/ps2_recompiled_stubs.h
ps2xRuntime/src/runner/ps2_recompiled_functions.cpp
ps2xRuntime/src/runner/register_functions.cpp
ps2xRuntime/output
# generated game code (BYO-ISO; see games/*/setup.sh)
# Generated by games/bt3/setup.py (sync_tree). NO trailing slash -- same reason as
# runner_overlay below: it was tracked as a symlink to an absolute path and a
# directory-only pattern let it through.
ps2xRuntime/src/runner
ps2xRuntime/src/runner/*.cpp
# Generated by games/bt3/vu1_programs.py from the ELF: the translated VU1 microprograms (game code)
ps2xRuntime/src/lib/vu1_jit_gen.inc
games/*/work/
# Generated by games/bt3/gen_overlay.py. NO trailing slash: with one this matches only a
# DIRECTORY, so a symlink of the same name slipped past it and got committed -- a symlink
# to an absolute path on one machine, which broke setup for everyone else (on Windows the
# zip materialises it as a plain file and gen_overlay.py dies with FileExistsError).
ps2xRuntime/src/runner_overlay
ps2xRuntime/include/ps2_overlay_functions.h

# Extracted game data + generated sources produced by games/bt3/setup.py. Never commit: it is the
# user's own ripped disc content, and it is gigabytes.
games/bt3/work

# Menu theme for the front-end. This is the game's own soundtrack, so it stays a local file the
# user drops next to the executable: the front-end looks for <exeDir>/music/. Never commit, and
# never let setup.py stage it into a distributed zip.
music/
ps2xRuntime/assets/music/


# local build/deploy scratch
log.txt
log_*.txt
__pycache__/


# local build trees (build_pre, build_pgs, ...)
build_*/
# ...and the hyphenated spelling, which is what PS2X_BUILD_DIR=build-linux wants: a Windows and a
# Linux build cannot share one tree, since FetchContent's subbuild caches record the configuring
# platform's absolute paths and CMake refuses to reuse them.
build-*/

# Agent instructions file, local only
AGENTS.md

# local deploy output + video scratch (game content, never commit)
deploy/
fmv_build/
launcher-build-log.txt

# runtime-generated game save data + imgui layout (local only)
games/bt3/savedata/
imgui.ini

# orchestrator runtime state (dev-local corpus)
tools/orchestrator/state.json
tools/orchestrator/corpus/
